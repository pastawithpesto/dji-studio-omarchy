        "push on a null wrapper returns 1",
        "insert_at and remove_at on a null wrapper return 1"
      ]
    },
    {
      "name": "pointer_fifo_and_front_back",
      "assertions": [
        "front and back pushes preserve order",
        "indexed pointer peek accepts 0 <= index < count",
        "invalid signed index returns null",
        "pointer pops return selected payload and update count",
        "null pointer payload is accepted"
      ]
    },
    {
      "name": "typed_slot_widths",
      "assertions": [
        "double payload preserves all eight representation bytes",
        "integer push/read uses exactly four payload bytes",
        "mixed-kind reads are outside approval and rejected by the Rust safety adaptation"
      ]
    },
    {
      "name": "insert_remove_bounds",
      "assertions": [
        "insert_at accepts 0 <= index <= count",
        "remove_at accepts 0 <= index < count",
        "negative signed indices and out-of-range indices return 1",
        "removing final element resets count to zero"
      ]
    },
    {
      "name": "sorted_insert",
      "assertions": [
        "callback receives existing entry word then candidate word",
        "negative comparison advances lower bound",
        "zero or positive comparison narrows upper bound",
        "equivalent entries insert before the first equivalent"
      ]
    }
  ],
