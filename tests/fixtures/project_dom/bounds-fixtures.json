{
  "classification": "Hand specified native-policy boundary/error fixtures; not vendor errors, no future serializer oracle",
  "defaults": {
    "max_output_bytes": 33554432,
    "max_depth": 64,
    "max_records": 100000
  },
  "cases": [
    {
      "id": "invalid-output-before-value",
      "input": {
        "kind": "F64Bits",
        "hex": "3fe0000000000000"
      },
      "limits_override": {
        "max_output_bytes": 33554433
      },
      "expected": {
        "result": "error",
        "kind": "InvalidLimits",
        "field": "OutputBytes",
        "requested": 33554433,
        "maximum": 33554432
      },
      "independent_basis": "33_554_433 exceeds hard output maximum; configuration precedes value inspection."
    },
    {
      "id": "invalid-depth-before-value",
      "input": {
        "kind": "F64Bits",
        "hex": "3fe0000000000000"
      },
      "limits_override": {
        "max_depth": 65
      },
      "expected": {
        "result": "error",
        "kind": "InvalidLimits",
        "field": "Depth",
        "requested": 65,
        "maximum": 64
      },
      "independent_basis": "65 exceeds hard depth maximum before real classification."
    },
    {
      "id": "invalid-records-before-value",
      "input": {
        "kind": "F64Bits",
        "hex": "3fe0000000000000"
      },
      "limits_override": {
        "max_records": 100001
      },
      "expected": {
        "result": "error",
        "kind": "InvalidLimits",
        "field": "Records",
        "requested": 100001,
        "maximum": 100000
      },
      "independent_basis": "100001 exceeds hard record maximum."
    },
    {
      "id": "invalid-config-field-order",
      "input": {
        "kind": "F64Bits",
        "hex": "3fe0000000000000"
      },
      "limits_override": {
        "max_output_bytes": 33554433,
        "max_depth": 65,
        "max_records": 100001
      },
      "expected": {
        "result": "error",
        "kind": "InvalidLimits",
        "field": "OutputBytes",
        "requested": 33554433,
        "maximum": 33554432
      },
      "independent_basis": "Fixed configuration field order OutputBytes,Depth,Records."
    },
    {
      "id": "null-exact-small-caps",
      "input": {
        "kind": "Null"
      },
      "limits_override": {
        "max_output_bytes": 4,
        "max_depth": 0,
        "max_records": 1
      },
      "expected": {
        "result": "success",
        "byte_length": 4,
        "expected_hex": "6e756c6c",
        "crc32_hex": "25cbfc4f"
      },
      "independent_basis": "Root depth0,one value record,one4-byte atom."
    },
    {
      "id": "null-output-minus-one",
      "input": {
        "kind": "Null"
      },
      "limits_override": {
        "max_output_bytes": 3
      },
      "expected": {
        "result": "error",
        "kind": "OutputLimit",
        "limit": 3,
        "attempted_bytes": 4
      },
      "independent_basis": "Null atom is one complete4-byte chunk."
    },
    {
      "id": "null-zero-output",
      "input": {
        "kind": "Null"
      },
      "limits_override": {
        "max_output_bytes": 0
      },
      "expected": {
        "result": "error",
        "kind": "OutputLimit",
        "limit": 0,
        "attempted_bytes": 4
      },
      "independent_basis": "Zero output is valid configuration but cannot contain atom."
    },
    {
      "id": "null-zero-records",
